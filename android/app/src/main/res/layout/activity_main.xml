<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_teal"
        app:logo="@drawable/ic_logo_toolbar"
        app:title="@string/title" app:subtitle="@string/subtitle"
        app:titleMarginStart="12dp"
        app:titleTextColor="@color/white" app:subtitleTextColor="@color/white" />

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent" android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/surface_tint"
            android:gravity="center" android:orientation="vertical">
            <ImageView
                android:layout_width="84dp" android:layout_height="100dp"
                android:contentDescription="@null" android:src="@drawable/ic_mascot" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/loading"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
