<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_teal"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/contact_us" app:subtitle="@string/brand"
        app:titleTextColor="@color/white" app:subtitleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@color/brand_pink_soft" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="14dp">
                <ImageView
                    android:layout_width="50dp" android:layout_height="60dp"
                    android:contentDescription="@null" android:src="@drawable/ic_mascot" />
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/contact_title" android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceTitleLarge" />
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/contact_intro"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/sec_society"
                android:textAppearance="@style/Demo.SectionTitle" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_society"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_society">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/society"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_address"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_address">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/address"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPostalAddress|textCapWords|textMultiLine" android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_city"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_city">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/city"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_pin"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_pin">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pin"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/sec_contact"
                android:textAppearance="@style/Demo.SectionTitle" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_person"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/person"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_role"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_role">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/role"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_mobile"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_mobile" app:prefixText="+91 ">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mobile"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="phone" android:maxLength="14" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_email"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_email">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_time"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_time">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/time"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/sec_water"
                android:textAppearance="@style/Demo.SectionTitle" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_buildings"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_buildings">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/buildings"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_flats"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_flats">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/flats"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:baselineAligned="false">
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="6dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_tanks"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_tanks">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tanks"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="3" />
            </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_sumps"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_sumps">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sumps"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="2" />
            </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/f_tanks_help"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/ink_2" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/sec_more"
                android:textAppearance="@style/Demo.SectionTitle" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/l_message"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:hint="@string/f_message">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/message"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences" android:minLines="3" android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/consent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/f_consent" />
            <TextView
                android:id="@+id/consentError"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:textColor="?attr/colorError"
                android:textAppearance="?attr/textAppearanceBodySmall" android:visibility="gone" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/privacy_note"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/ink_2" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="10dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendWhatsapp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/send_whatsapp" app:icon="@drawable/ic_send"
            app:backgroundTint="@color/brand_teal" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendOther"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/send_other" app:icon="@drawable/ic_share" />
    </LinearLayout>
</LinearLayout>
