<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Demo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="colorSecondary">@color/brand_pink</item>
        <item name="colorTertiary">@color/brand_pink</item>
        <item name="android:statusBarColor">@color/brand_teal</item>
        <item name="android:windowBackground">@color/surface_tint</item>
    </style>
    <style name="Theme.Demo.Starting">
        <item name="android:windowSplashScreenBackground">@color/brand_teal</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_teal</item>
    </style>
    <style name="Demo.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/brand_teal</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
